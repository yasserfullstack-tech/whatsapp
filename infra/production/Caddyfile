{
	email {$CADDY_EMAIL}
	admin off
}

http://{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

https://{$APP_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size {$CADDY_MAX_REQUEST_BODY:16MB}
	}

	log {
		output stdout
		format json
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	}

	# Metrics stay on the private Compose network and are scraped by Prometheus.
	@metrics path /metrics
	respond @metrics 404

	@api path /api/v1/* /health /ready
	reverse_proxy @api api:4000 {
		health_uri /health
		health_interval 30s
		health_timeout 3s
		fail_duration 30s
		max_fails 3
	}

	reverse_proxy web:3000 {
		health_uri /
		health_interval 30s
		health_timeout 3s
		fail_duration 30s
		max_fails 3
	}
}
