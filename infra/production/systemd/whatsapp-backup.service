[Unit]
Description=WhatsApp production encrypted PostgreSQL backup
Documentation=https://github.com/yasserfullstack-tech/whatsapp/blob/main/docs/backups.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=APP_DIR=/srv/whatsapp
EnvironmentFile=/etc/whatsapp/backup.env
ExecStart=/bin/sh -c 'cd "$APP_DIR" && exec ./infra/production/scripts/backup-postgres.sh'
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
