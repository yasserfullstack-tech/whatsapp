NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

DATABASE_URL=postgres://whatsapp:whatsapp@localhost:5432/whatsapp
REDIS_URL=redis://localhost:6379

# Better Auth (generate a long random value for production)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# 32 random bytes, base64 encoded. Used to encrypt per-client Meta credentials at rest.
# Example: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Meta app / WhatsApp Embedded Signup
META_GRAPH_API_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_VERIFY_TOKEN=replace-me-with-a-long-random-token

# Development/testing fallback only. Production sending will read per-number encrypted credentials.
META_ACCESS_TOKEN=

DEFAULT_META_MPS=80
WORKER_CONCURRENCY=400
