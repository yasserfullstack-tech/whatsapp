NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WORKER_METRICS_PORT=9464

DATABASE_URL=postgres://whatsapp:whatsapp@localhost:5432/whatsapp
REDIS_URL=redis://localhost:6379

# Optional error reporting. Leave SENTRY_DSN empty to disable Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Better Auth (generate a long random value for production)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Bootstrap-only allowlists for the first platform administrator(s).
# This is independent from workspace owner/admin/member/viewer roles. Prefer exact Better
# Auth user IDs. Email bootstrap is accepted only when Better Auth marks the email verified.
PLATFORM_ADMIN_USER_IDS=
PLATFORM_ADMIN_EMAILS=

# Transactional authentication email. In development, auth emails are logged if these are unset.
# Production requires both RESEND_API_KEY and AUTH_EMAIL_FROM.
RESEND_API_KEY=
AUTH_EMAIL_FROM=WhatsApp Campaigns <security@example.com>
AUTH_EMAIL_REPLY_TO=

# 32 random bytes, base64 encoded. Used to encrypt per-client Meta credentials at rest.
# Example: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Meta app / WhatsApp Embedded Signup + webhook signature verification
META_GRAPH_API_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration created for WhatsApp Embedded Signup v4.
# Configure products, assets, and permissions in the Meta App Dashboard configuration.
META_CONFIG_ID=
META_VERIFY_TOKEN=replace-me-with-a-long-random-token

# Development/testing fallback only. Production campaign sending reads per-number encrypted credentials.
META_ACCESS_TOKEN=

# Cloudflare R2 private bucket used for CSV imports/exports.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=whatsapp-imports

DEFAULT_META_MPS=80
WORKER_CONCURRENCY=400
WEBHOOK_CONCURRENCY=100
CAMPAIGN_DISPATCH_CONCURRENCY=8
CONTACT_IMPORT_CONCURRENCY=2