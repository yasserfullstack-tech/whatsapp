NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

DATABASE_URL=postgres://whatsapp:whatsapp@localhost:5432/whatsapp
REDIS_URL=redis://localhost:6379

# Current Graph API version as of project bootstrap. Keep this configurable.
META_GRAPH_API_VERSION=v26.0
META_VERIFY_TOKEN=replace-me
# Development/testing only. Production credentials must come from a secret provider per client.
META_ACCESS_TOKEN=

DEFAULT_META_MPS=80
WORKER_CONCURRENCY=400
