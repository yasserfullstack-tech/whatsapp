{
  "name": "whatsapp-marketing-platform",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter @wa/web --filter @wa/api --filter @wa/worker dev",
    "dev:web": "bun run --filter @wa/web dev",
    "dev:api": "bun run --filter @wa/api dev",
    "dev:worker": "bun run --filter @wa/worker dev",
    "build": "bun run --filter @wa/web build",
    "test": "bun test",
    "test:e2e": "bun e2e/support/run-e2e.ts",
    "test:security": "playwright test -c playwright.security.config.ts",
    "typecheck": "bun run --filter '@wa/*' typecheck",
    "validate:provider-evidence": "bun infra/production/scripts/validate-provider-evidence.ts",
    "db:generate": "bun run --filter @wa/db db:generate",
    "db:migrate": "bun run --filter @wa/db db:migrate",
    "db:verify": "bun run --filter @wa/db db:verify",
    "db:push:dev": "bun run --filter @wa/db db:push:dev",
    "infra:up": "docker compose up -d postgres valkey",
    "infra:down": "docker compose down",
    "observability:up": "docker compose --profile observability up -d prometheus grafana",
    "observability:down": "docker compose --profile observability stop prometheus grafana",
    "load:infra:up": "docker compose -f docker-compose.load.yml up -d --wait",
    "load:infra:down": "docker compose -f docker-compose.load.yml down --remove-orphans",
    "load:fake-meta": "bun run --filter @wa/load-test fake-meta",
    "load:run": "bun run --filter @wa/load-test run",
    "load:stress": "bun run --filter @wa/load-test stress",
    "load:soak": "bun run --filter @wa/load-test soak",
    "load:recovery": "bun run --filter @wa/load-test recovery",
    "load:chaos": "bun run --filter @wa/load-test chaos",
    "load:webhooks": "bun run --filter @wa/load-test webhook-flood",
    "load:webhook-status": "bun run --filter @wa/load-test webhook-status-flood"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  }
}
