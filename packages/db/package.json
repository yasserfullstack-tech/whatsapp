{
  "name": "@wa/db",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "bun src/generate-migration.ts",
    "db:snapshots:materialize": "bun src/snapshot-artifacts.ts materialize",
    "db:snapshots:pack": "bun src/snapshot-artifacts.ts pack",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "bun src/migrate-runtime.ts",
    "db:verify": "bun src/verify-migrations.ts",
    "db:push:dev": "drizzle-kit push"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
